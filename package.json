{
  "name": "@v02/metalstorm-core",
  "version": "0.1.0",
  "description": "The MetalStorm build code format and the types two apps need to agree on to share one. No data, no framework, no runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "test",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.mjs\"",
    "prepare": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
